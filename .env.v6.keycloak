# Superset + Keycloak staging env
# Replace every TODO_* value before starting the stack.

# -----------------------------
# Superset core
# -----------------------------
SUPERSET_ENV=production
SUPERSET_LOAD_EXAMPLES=no
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_EMAIL=admin@superset.local
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_FIRSTNAME=Admin
SUPERSET_ADMIN_LASTNAME=User

# TODO_1: generate a long random secret (at least 32 chars)
SUPERSET_SECRET_KEY=TODO_SET_LONG_RANDOM_SECRET

# Enable OAuth only on this staging instance
ENABLE_KEYCLOAK_OAUTH=true

# -----------------------------
# Keycloak OIDC
# -----------------------------
# TODO_2: Keycloak base host (no trailing slash, no /realms path)
# Example: https://keycloak.company.it
KEYCLOAK_BASE_URL=TODO_SET_KEYCLOAK_BASE_URL

# TODO_3: realm name
KEYCLOAK_REALM=TODO_SET_KEYCLOAK_REALM

# TODO_4: client id configured in Keycloak (usually superset)
KEYCLOAK_CLIENT_ID=superset

# TODO_5: client secret from Keycloak -> Clients -> Credentials
KEYCLOAK_CLIENT_SECRET=TODO_SET_KEYCLOAK_CLIENT_SECRET

# -----------------------------
# Superset user/role sync
# -----------------------------
AUTH_USER_REGISTRATION_ROLE=Gamma
AUTH_ROLES_SYNC_AT_LOGIN=true

# -----------------------------
# Proxy / security (staging)
# -----------------------------
ENABLE_PROXY_FIX=true
WTF_CSRF_ENABLED=false
TALISMAN_ENABLED=false
X_FRAME_OPTIONS=ALLOWALL

# TODO_6: comma-separated allowed origins
# Include at least Superset staging URL and toolbox URL.
# Example: http://localhost:17790,https://toolbox.example.org
CORS_ALLOWED_ORIGINS=TODO_SET_ALLOWED_ORIGINS

# Optional tuning
SUPERSET_WEBSERVER_TIMEOUT=300
SQLLAB_ASYNC_TIME_LIMIT_SEC=300

