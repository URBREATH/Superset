# .env.v6 ? Variabili d'ambiente per stack Superset 6.1.0 (WSL test)

# ?? Superset ????????????????????????????????????????????????????????
SUPERSET_ENV=production
SUPERSET_LOAD_EXAMPLES=no
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_EMAIL=admin@superset.local
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_FIRSTNAME=Admin
SUPERSET_ADMIN_LASTNAME=User
SUPERSET_SECRET_KEY=CHANGE_ME_SUPERSET_SECRET_KEY_LONG_RANDOM

# OAuth Keycloak (toggle rollout)
ENABLE_KEYCLOAK_OAUTH=false
KEYCLOAK_BASE_URL=https://keycloak-dev.urbreath.tech/auth
KEYCLOAK_REALM=urbreath-auth
KEYCLOAK_CLIENT_ID=urbreath
KEYCLOAK_CLIENT_SECRET=w0Ebfzs3lqjorCWXypaj0wzyLL8TUqLi
AUTH_USER_REGISTRATION_ROLE=Gamma
AUTH_ROLES_SYNC_AT_LOGIN=true

# Security and reverse proxy
ENABLE_PROXY_FIX=true
WTF_CSRF_ENABLED=false
TALISMAN_ENABLED=false
X_FRAME_OPTIONS=ALLOWALL
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:17789

# Optional tuning
SUPERSET_WEBSERVER_TIMEOUT=300
SQLLAB_ASYNC_TIME_LIMIT_SEC=300

# ?? React Frontend ??????????????????????????????????????????????????
# URL raggiungibile DAL BROWSER (porta WSL esposta automaticamente su Windows)
REACT_APP_SUPERSET_URL=http://localhost:17790
REACT_APP_SUPERSET_TECHNICAL_USERNAME=embedded_service
REACT_APP_SUPERSET_TECHNICAL_PASSWORD=UrbEmbSvc_2026_vZ9mQ7pL4tN8

