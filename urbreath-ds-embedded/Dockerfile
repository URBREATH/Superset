# Dockerfile nella cartella della webapp React
FROM node:18 AS build
WORKDIR /app
ARG REACT_APP_SUPERSET_URL
ARG REACT_APP_SUPERSET_TECHNICAL_USERNAME
ARG REACT_APP_SUPERSET_TECHNICAL_PASSWORD
ARG REACT_APP_DASHBOARD_MADRID
ARG REACT_APP_DASHBOARD_CLUJ
ARG REACT_APP_DASHBOARD_TALLINN
ARG REACT_APP_DASHBOARD_LEUVEN
ARG REACT_APP_DASHBOARD_MADRID_LINK
ARG REACT_APP_DASHBOARD_CLUJ_LINK
ARG REACT_APP_DASHBOARD_LEUVEN_LINK
ARG REACT_APP_DASHBOARD_TALLINN_LINK
ENV REACT_APP_SUPERSET_URL=$REACT_APP_SUPERSET_URL
ENV REACT_APP_SUPERSET_TECHNICAL_USERNAME=$REACT_APP_SUPERSET_TECHNICAL_USERNAME
ENV REACT_APP_SUPERSET_TECHNICAL_PASSWORD=$REACT_APP_SUPERSET_TECHNICAL_PASSWORD
ENV REACT_APP_DASHBOARD_MADRID=$REACT_APP_DASHBOARD_MADRID
ENV REACT_APP_DASHBOARD_CLUJ=$REACT_APP_DASHBOARD_CLUJ
ENV REACT_APP_DASHBOARD_TALLINN=$REACT_APP_DASHBOARD_TALLINN
ENV REACT_APP_DASHBOARD_LEUVEN=$REACT_APP_DASHBOARD_LEUVEN
ENV REACT_APP_DASHBOARD_MADRID_LINK=$REACT_APP_DASHBOARD_MADRID_LINK
ENV REACT_APP_DASHBOARD_CLUJ_LINK=$REACT_APP_DASHBOARD_CLUJ_LINK
ENV REACT_APP_DASHBOARD_LEUVEN_LINK=$REACT_APP_DASHBOARD_LEUVEN_LINK
ENV REACT_APP_DASHBOARD_TALLINN_LINK=$REACT_APP_DASHBOARD_TALLINN_LINK
COPY package*.json ./
RUN npm install
COPY . .
ENV PUBLIC_URL=/app
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/build /usr/share/nginx/html/app
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]